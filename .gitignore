# Windows default autosave extension
*.asv

# Shortcut files
*.lnk

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Generated helpsearch folders
helpsearch*/

# Simulink code generation folders
slprj/
sccprj/

# Settings folder
Palladium DAQ/Palladium DAQ - Settings/

# Batch script
palladium_push.bat

#Project and toolbox automatic files
deploymentLog.html
derived/*
resources/*

#Python cache files
*.pyc
*.cpyth

#Documentation output - Docs is built entirely by the buildfile (doc and gettingStarted
#tasks) from the Markdown sources in DocsSrc. Track only the .gitkeep that keeps the folder
Palladium DAQ/Docs/*
!Palladium DAQ/Docs/.gitkeep
#Generated API reference Markdown - built by the apidoc task from the code's help comments
Palladium DAQ/DocsSrc/reference/