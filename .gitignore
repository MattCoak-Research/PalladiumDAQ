# Windows default autosave extension
*.asv

# Shortcut files
*.lnk

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Generated helpsearch folders
helpsearch*/

# Simulink code generation folders
slprj/
sccprj/

# Settings folder
Palladium DAQ/Palladium DAQ - Settings/

# Batch script
palladium_push.bat

#Project and toolbox automatic files
deploymentLog.html
derived/*
resources/*

#Python cache files
*.pyc
*.cpyth

#Documentation output - docs will be generated in the buildfile. Just track the markdown .md files
Palladium DAQ/Docs/**/*.xml
Palladium DAQ/Docs/**/*.html
Palladium DAQ/Docs/resources/
#Generated API reference Markdown - built by the apidoc task from the code's help comments
Palladium DAQ/Docs/reference/
#Generated Getting Started guide - built by the gettingStarted task from Docs/GettingStarted.md
Palladium DAQ/Docs/GettingStarted.m